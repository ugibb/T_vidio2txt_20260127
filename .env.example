# ===========================================================================
# 环境变量示例：复制为 .env 后填写真实值
#   cp .env.example .env
# .env 已在 .gitignore 中忽略，请勿提交真实秘钥。
# ===========================================================================

# ---------------------------------------------------------------------------
# 必填：OpenAI 兼容 API Key（各平台 Key 均用此变量名）
# ---------------------------------------------------------------------------
OPENAI_API_KEY=

# ---------------------------------------------------------------------------
# 可选：切换 LLM 服务商（不设置则用 src/config.py 中的默认值）
# ---------------------------------------------------------------------------

# 智谱 GLM-4（config.py 默认）
# LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# LLM_MODEL=glm-4

# Kimi 国内（platform.moonshot.cn 创建的 Key，通常以 sk-kimi- 开头）
# 注意：Key 与端点必须对应，否则会 401 Invalid Authentication
# LLM_BASE_URL=https://api.moonshot.cn/v1
# LLM_MODEL=kimi-k2.5

# DeepSeek
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_MODEL=deepseek-chat

# 通义千问（须用百炼 API Key，sk- 开头；不可使用 RAM accessKey）
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_MODEL=qwen-max

# OpenAI（BASE_URL 留空即用官方端点）
# LLM_MODEL=gpt-4o-mini

# ---------------------------------------------------------------------------
# 可选：请求调优
# ---------------------------------------------------------------------------
# 单次请求超时秒数（大文本适当增大）
# LLM_TIMEOUT=180

# 连接失败重试次数
# LLM_MAX_RETRIES=3
